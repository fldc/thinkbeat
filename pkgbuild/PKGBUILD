pkgname=thinkbeat
pkgver=0.1.0
pkgrel=1
pkgdesc='Pulse the ThinkPad red lid LED to system playback audio'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'libpulse')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/thinkbeat "$pkgdir/usr/bin/thinkbeat"
  install -Dm755 bin/enable-led "$pkgdir/usr/bin/thinkbeat-enable-led"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/thinkbeat.desktop" "$pkgdir/usr/share/applications/thinkbeat.desktop"
  install -Dm644 "$startdir/thinkbeat.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/thinkbeat.svg"
}
